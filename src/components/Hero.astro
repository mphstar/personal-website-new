---
import data_experience from "../models/data_experience";
import data_education from "../models/data_education";
import data_contact from "../models/data_contact";
import data_portfolio from "../models/data_portfolio";
import imageDimensions from "../models/image-dimensions";
import DiscordActivity from "./DiscordActivity.astro";

function sizeFor(src: string | null | undefined) {
  if (!src) return {};
  const size = imageDimensions[src];
  return size ? { width: size[0], height: size[1] } : {};
}

const stats = [
  { label: "Roblox visits", value: "975k+" },
  { label: "Projects shipped", value: String(data_portfolio.length) },
  { label: "Roles since 2020", value: String(data_experience.length) },
  { label: "GPA, Informatics", value: "3.93" },
];

const skills = Array.from(
  new Set(data_portfolio.flatMap((project) => project.build ?? [])),
);

const featuredTitles = ["WG Optical", "Tijara Store", "J-ViMS"];
const featured = featuredTitles.flatMap((title) => {
  const project = data_portfolio.find((item) => item.title === title);
  return project ? [project] : [];
});

const contactIcons: Record<string, string> = {
  Email:
    '<path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 0 1-2.25 2.25h-15a2.25 2.25 0 0 1-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0 0 19.5 4.5h-15a2.25 2.25 0 0 0-2.25 2.25m19.5 0v.243a2.25 2.25 0 0 1-1.07 1.916l-7.5 4.615a2.25 2.25 0 0 1-2.36 0L3.32 8.91a2.25 2.25 0 0 1-1.07-1.916V6.75" />',
  Github:
    '<path fill-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" clip-rule="evenodd" />',
  Facebook:
    '<path fill-rule="evenodd" d="M22 12c0-5.523-4.477-10-10-10S2 6.477 2 12c0 4.991 3.657 9.128 8.438 9.878v-6.987h-2.54V12h2.54V9.797c0-2.506 1.492-3.89 3.777-3.89 1.094 0 2.238.195 2.238.195v2.46h-1.26c-1.243 0-1.63.771-1.63 1.562V12h2.773l-.443 2.89h-2.33v6.988C18.343 21.128 22 16.991 22 12z" clip-rule="evenodd" />',
  Instagram:
    '<path fill-rule="evenodd" d="M12.315 2c2.43 0 2.784.013 3.808.06 1.064.049 1.791.218 2.427.465a4.902 4.902 0 011.772 1.153 4.902 4.902 0 011.153 1.772c.247.636.416 1.363.465 2.427.048 1.067.06 1.407.06 4.123v.08c0 2.643-.012 2.987-.06 4.043-.049 1.064-.218 1.791-.465 2.427a4.902 4.902 0 01-1.153 1.772 4.902 4.902 0 01-1.772 1.153c-.636.247-1.363.416-2.427.465-1.067.048-1.407.06-4.123.06h-.08c-2.643 0-2.987-.012-4.043-.06-1.064-.049-1.791-.218-2.427-.465a4.902 4.902 0 01-1.772-1.153 4.902 4.902 0 01-1.153-1.772c-.247-.636-.416-1.363-.465-2.427-.047-1.024-.06-1.379-.06-3.808v-.63c0-2.43.013-2.784.06-3.808.049-1.064.218-1.791.465-2.427a4.902 4.902 0 011.153-1.772A4.902 4.902 0 015.45 2.525c.636-.247 1.363-.416 2.427-.465C8.901 2.013 9.256 2 11.685 2h.63zm-.081 1.802h-.468c-2.456 0-2.784.011-3.807.058-.975.045-1.504.207-1.857.344-.467.182-.8.398-1.15.748-.35.35-.566.683-.748 1.15-.137.353-.3.882-.344 1.857-.047 1.023-.058 1.351-.058 3.807v.468c0 2.456.011 2.784.058 3.807.045.975.207 1.504.344 1.857.182.466.399.8.748 1.15.35.35.683.566 1.15.748.353.137.882.3 1.857.344 1.054.048 1.37.058 4.041.058h.08c2.597 0 2.917-.01 3.96-.058.976-.045 1.505-.207 1.858-.344.466-.182.8-.398 1.15-.748.35-.35.566-.683.748-1.15.137-.353.3-.882.344-1.857.048-1.055.058-1.37.058-4.041v-.08c0-2.597-.01-2.917-.058-3.96-.045-.976-.207-1.505-.344-1.858a3.097 3.097 0 00-.748-1.15 3.098 3.098 0 00-1.15-.748c-.353-.137-.882-.3-1.857-.344-1.023-.047-1.351-.058-3.807-.058zM12 6.865a5.135 5.135 0 110 10.27 5.135 5.135 0 010-10.27zm0 1.802a3.333 3.333 0 100 6.666 3.333 3.333 0 000-6.666zm5.338-3.205a1.2 1.2 0 110 2.4 1.2 1.2 0 010-2.4z" clip-rule="evenodd" />',
  LinkedIn:
    '<path fill-rule="evenodd" d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z" clip-rule="evenodd" />',
  Youtube:
    '<path fill-rule="evenodd" d="M21.582 6.186a2.665 2.665 0 00-1.876-1.888C18.04 3.864 12 3.864 12 3.864s-6.04 0-7.706.434A2.664 2.664 0 002.418 6.186C2 7.87 2 12 2 12s0 4.13.418 5.814a2.665 2.665 0 001.876 1.888c1.666.434 7.706.434 7.706.434s6.04 0 7.706-.434a2.664 2.664 0 001.876-1.888C22 16.13 22 12 22 12s0-4.13-.418-5.814zM9.8 15.592V8.408L15.916 12 9.8 15.592z" clip-rule="evenodd" />',
};
---

<section class="animate-fade-in">
  <header class="flex flex-col gap-5 sm:flex-row sm:items-center">
    <img
      src="/assets/pp-192.webp"
      srcset="/assets/pp-192.webp 1x, /assets/pp-384.webp 2x"
      width="192"
      height="192"
      alt="Bintang Malindo Eka Putra (Mphstar)"
      class="w-20 h-20 sm:w-24 sm:h-24 rounded-full object-cover border border-gray-200 dark:border-gray-800"
      loading="eager"
      fetchpriority="high"
      decoding="async"
    />
    <div>
      <div class="flex flex-wrap items-center gap-3">
        <h1 class="text-2xl font-semibold tracking-tight dark:text-gray-100">Mphstar</h1>
        <span
          class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-[11px] font-semibold tracking-wide uppercase select-none bg-emerald-600 text-white dark:bg-emerald-700"
        >
          <span class="inline-flex rounded-full h-1.5 w-1.5 bg-emerald-300"></span>
          Open to Work
        </span>
      </div>
      <p class="mt-1.5 text-sm text-gray-500 dark:text-gray-400">
        Bintang Malindo Eka Putra &mdash; Web &amp; Mobile Developer
      </p>
    </div>
  </header>

  <p class="mt-9 text-lg leading-relaxed text-gray-800 dark:text-gray-200">
    Fresh graduate in Informatics Engineering from Jember State Polytechnic,
    building web and mobile products end to end.
  </p>

  <p class="mt-4 leading-relaxed text-gray-600 dark:text-gray-400">
    I work well both independently and in a team, plan before I build, and adapt
    quickly to new stacks and unfamiliar problems.
  </p>

  <dl
    class="mt-10 grid grid-cols-2 gap-x-6 gap-y-7 border-t border-gray-200 pt-7 dark:border-gray-800 sm:grid-cols-4"
  >
    {
      stats.map((stat) => (
        <div>
          <dt class="text-[11px] font-medium uppercase tracking-wider text-gray-500 dark:text-gray-400">
            {stat.label}
          </dt>
          <dd class="mt-1 text-2xl font-semibold tabular-nums tracking-tight text-gray-900 dark:text-gray-100">
            {stat.value}
          </dd>
        </div>
      ))
    }
  </dl>

  <p class="mt-8 flex flex-wrap items-baseline gap-x-2 gap-y-1 text-sm text-gray-500 dark:text-gray-400">
    <span class="text-[11px] font-medium uppercase tracking-wider text-gray-400 dark:text-gray-400">
      Stack
    </span>
    <span class="text-gray-300 dark:text-gray-700">&mdash;</span>
    <span>{skills.join(" · ")}</span>
  </p>

  <div class="reveal-on-scroll mt-16">
    <div class="flex items-baseline justify-between gap-4 mb-6">
      <h2 class="text-lg font-semibold dark:text-gray-100">Selected work</h2>
      <a
        href="/portfolio"
        class="group inline-flex items-center gap-1 text-sm font-medium text-gray-500 hover:text-black dark:text-gray-400 dark:hover:text-white transition-colors"
      >
        All {data_portfolio.length} projects
        <svg
          class="w-3.5 h-3.5 group-hover:translate-x-0.5 transition-transform duration-300"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
          aria-hidden="true"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M14 5l7 7m0 0l-7 7m7-7H3"
          />
        </svg>
      </a>
    </div>
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
      {
        featured.map((item, index) => (
          <article
            class={`work-card flex flex-col ${index === 0 ? "sm:col-span-2" : ""}`}
          >
            {item.image && (
              <a
                href={item.redirect ?? item.image}
                target="_blank"
                rel="noopener noreferrer"
                class="view-media"
                style="--view-ratio: 16 / 9;"
                aria-label={`Open ${item.title}`}
              >
                <img
                  src={item.image}
                  alt={item.title}
                  {...sizeFor(item.image)}
                  class="w-full max-h-64 object-cover border border-gray-200 dark:border-gray-800 rounded-xl opacity-95 dark:opacity-85 hover:opacity-100 transition-all duration-500 ease-[cubic-bezier(0.16,1,0.3,1)] hover:scale-[1.02]"
                  loading="lazy"
                />
              </a>
            )}
            <div class="view-body flex flex-1 flex-col">
              <h3 class="view-title text-base font-medium text-gray-900 dark:text-gray-100">
                {item.title}
              </h3>
              <p class="view-clamp mt-1.5 text-sm leading-relaxed text-gray-600 dark:text-gray-400">
                {item.deskripsi}
              </p>
              <div class="mt-auto flex flex-wrap gap-1.5 pt-3">
                {item.build &&
                  item.build.length > 0 &&
                  item.build.map((tech) => (
                    <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[11px] font-medium bg-gray-100 dark:bg-gray-800 text-gray-600 dark:text-gray-300 border border-gray-200 dark:border-gray-700">
                      {tech}
                    </span>
                  ))}
              </div>
            </div>
          </article>
        ))
      }
    </div>
  </div>

  <div class="reveal-on-scroll mt-16">
    <h2 class="text-lg font-semibold mb-6 dark:text-gray-100">Experience</h2>
    <ol class="relative ml-1.5 border-l border-gray-200 dark:border-gray-800">
      {
        data_experience.map((exp, index) => (
          <li
            class={`relative pl-6 ${index === 0 ? "" : "mt-8"}`}
          >
            <span
              class="absolute -left-[4.5px] top-2 h-2 w-2 rounded-full bg-gray-300 dark:bg-gray-600"
              aria-hidden="true"
            />
            <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-0.5">
              <h3 class="font-medium dark:text-gray-100">{exp.role}</h3>
              <span class="text-xs tabular-nums text-gray-500 dark:text-gray-400">
                {exp.date}
              </span>
            </div>
            <p class="text-sm text-gray-600 dark:text-gray-400">
              {exp.company}
              <span class="mx-1 text-gray-300 dark:text-gray-700">&bull;</span>
              <span class="text-gray-500 dark:text-gray-400">{exp.location}</span>
            </p>

            {exp.descriptions.length > 0 && (
              <details class="details-toggle group mt-2" open={index === 0}>
                <summary class="inline-flex items-center gap-1 text-xs font-medium text-gray-500 hover:text-black dark:text-gray-400 dark:hover:text-white transition-colors">
                  {exp.descriptions.length} highlights
                  <svg
                    class="chevron h-3 w-3"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                    aria-hidden="true"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M6 9l6 6 6-6"
                    />
                  </svg>
                </summary>
                <ul class="mt-2 list-disc list-inside text-sm leading-relaxed text-gray-700 dark:text-gray-300 space-y-1">
                  {exp.descriptions.map((desc) => (
                    <li>{desc}</li>
                  ))}
                </ul>
              </details>
            )}
          </li>
        ))
      }
    </ol>
  </div>

  <div class="reveal-on-scroll mt-16">
    <h2 class="text-lg font-semibold mb-6 dark:text-gray-100">Education</h2>
    <div class="space-y-6">
      {
        data_education.map((edu) => (
          <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-0.5">
            <h3 class="font-medium dark:text-gray-100">{edu.school}</h3>
            <span class="text-xs tabular-nums text-gray-500 dark:text-gray-400">
              {edu.period}
            </span>
            <p class="w-full text-sm text-gray-600 dark:text-gray-400">
              {edu.major}
            </p>
          </div>
        ))
      }
    </div>
  </div>

  <div class="reveal-on-scroll mt-16">
    <h2 class="text-lg font-semibold mb-2 dark:text-gray-100">Contact</h2>
    <p class="text-sm text-gray-600 dark:text-gray-400 mb-5">
      Open to new roles and collaborations. The fastest way to reach me:
    </p>
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 reveal-stagger">
      {
        data_contact.map((contact) => {
          const iconHtml = contactIcons[contact.platform] ?? "";

          return (
            <a
              href={contact.link}
              target="_blank"
              rel="noopener noreferrer"
              class="group relative flex items-center gap-3.5 p-3.5 rounded-xl border border-gray-100 dark:border-gray-800/60 bg-white dark:bg-[#151515] hover:border-gray-300 dark:hover:border-gray-600 shadow-sm hover:shadow-md transition-all duration-300 hover:-translate-y-0.5 overflow-hidden"
            >
              <div class="absolute inset-0 bg-gradient-to-r from-gray-50 to-transparent dark:from-white/5 opacity-0 group-hover:opacity-100 transition-opacity duration-300" />

              <div class="relative flex-shrink-0 flex items-center justify-center w-9 h-9 rounded-full bg-gray-50 dark:bg-black border border-gray-100 dark:border-gray-800 group-hover:scale-110 transition-transform duration-300 text-gray-700 dark:text-gray-300">
                <svg
                  class="w-4 h-4 fill-current stroke-current"
                  stroke-width="1.5"
                  viewBox="0 0 24 24"
                  set:html={iconHtml}
                />
              </div>

              <div class="relative flex flex-col overflow-hidden">
                <span class="text-[11px] text-gray-500 uppercase tracking-wider font-semibold mb-0.5">
                  {contact.platform}
                </span>
                <span class="text-sm font-medium truncate text-gray-900 dark:text-gray-100">
                  {contact.value}
                </span>
              </div>

              <div class="absolute right-3.5 text-gray-300 dark:text-gray-700 opacity-0 group-hover:opacity-100 transform translate-x-2 group-hover:translate-x-0 transition-all duration-300">
                <svg
                  class="w-4 h-4"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M14 5l7 7m0 0l-7 7m7-7H3"
                  />
                </svg>
              </div>
            </a>
          );
        })
      }
    </div>
  </div>

  <div class="reveal-on-scroll mt-16">
    <DiscordActivity />
  </div>
</section>
