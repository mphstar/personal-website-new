---
interface Props {
  userId?: string;
}

const { userId = "667270803896926208" } = Astro.props;
---

<section data-discord-presence data-user-id={userId} aria-label="Discord presence">
  <div class="flex items-baseline justify-between gap-3 mb-3">
    <h2 class="text-lg font-semibold dark:text-gray-100">Discord</h2>
    <span class="text-xs text-gray-400 dark:text-gray-500">Live activity</span>
  </div>
  <div
    data-discord-card
    class="rounded-xl border border-gray-100 dark:border-gray-800/60 bg-white dark:bg-[#151515] p-4 shadow-sm"
  >
    <div class="flex items-center gap-3" aria-hidden="true">
      <div class="w-12 h-12 rounded-full bg-gray-100 dark:bg-gray-800"></div>
      <div class="flex-1 space-y-2">
        <div class="h-3 w-28 rounded bg-gray-100 dark:bg-gray-800"></div>
        <div class="h-2.5 w-20 rounded bg-gray-100 dark:bg-gray-800"></div>
      </div>
    </div>
    <span class="sr-only">Loading Discord presence...</span>
  </div>
</section>

<script>
  type DiscordUser = {
    id: string;
    username?: string | null;
    global_name?: string | null;
    display_name?: string | null;
    avatar?: string | null;
    discriminator?: string | null;
  };

  type ActivityAssets = {
    large_image?: string | null;
    large_text?: string | null;
  };

  type ActivityEmoji = {
    id?: string | null;
    name?: string | null;
    animated?: boolean | null;
  };

  type Activity = {
    type: number;
    name?: string | null;
    details?: string | null;
    state?: string | null;
    url?: string | null;
    application_id?: string | null;
    assets?: ActivityAssets | null;
    timestamps?: { start?: number | null; end?: number | null } | null;
    emoji?: ActivityEmoji | null;
  };

  type Spotify = {
    track_id?: string | null;
    song?: string | null;
    artists?: string[] | null;
    album_art_url?: string | null;
    timestamps?: { start?: number | null; end?: number | null } | null;
  };

  type Presence = {
    discord_user?: DiscordUser;
    discord_status?: string | null;
    activities?: Activity[] | null;
    listening_to_spotify?: boolean | null;
    spotify?: Spotify | null;
    active_on_discord_desktop?: boolean | null;
    active_on_discord_mobile?: boolean | null;
    active_on_discord_web?: boolean | null;
  };

  type Connection = {
    ws: WebSocket | null;
    heartbeat?: number;
    reconnect?: number;
    delay: number;
    presence?: Presence;
    fetching?: boolean;
  };

  const STATUS: Record<string, { label: string; dot: string; text: string }> = {
    online: {
      label: "Online",
      dot: "bg-emerald-500",
      text: "text-emerald-600 dark:text-emerald-400",
    },
    idle: {
      label: "Idle",
      dot: "bg-amber-500",
      text: "text-amber-600 dark:text-amber-400",
    },
    dnd: {
      label: "Do Not Disturb",
      dot: "bg-red-500",
      text: "text-red-600 dark:text-red-400",
    },
    offline: {
      label: "Offline",
      dot: "bg-gray-400",
      text: "text-gray-500",
    },
  };

  const TYPE_LABEL: Record<number, string> = {
    0: "Playing",
    1: "Streaming",
    2: "Listening to",
    3: "Watching",
    5: "Competing in",
  };

  const ESCAPES: Record<string, string> = {
    "&": "&amp;",
    "<": "&lt;",
    ">": "&gt;",
    '"': "&quot;",
    "'": "&#39;",
  };

  const connections = new Map<string, Connection>();

  function esc(value: unknown): string {
    return String(value ?? "").replace(/[&<>"']/g, (char) => ESCAPES[char]);
  }

  function safeUrl(value: unknown): string | null {
    if (typeof value !== "string") return null;
    try {
      const url = new URL(value);
      return url.protocol === "https:" ? url.toString() : null;
    } catch {
      return null;
    }
  }

  function toMs(value: unknown): number | null {
    const number = Number(value);
    if (!Number.isFinite(number) || number <= 0) return null;
    return number < 1e12 ? number * 1000 : number;
  }

  function formatTime(ms: number): string {
    const total = Math.max(0, Math.floor(ms / 1000));
    const hours = Math.floor(total / 3600);
    const minutes = Math.floor((total % 3600) / 60);
    const seconds = total % 60;
    return hours > 0
      ? `${hours}:${String(minutes).padStart(2, "0")}:${String(seconds).padStart(2, "0")}`
      : `${minutes}:${String(seconds).padStart(2, "0")}`;
  }

  function avatarUrl(user: DiscordUser): string {
    if (user.id && user.avatar) {
      const extension = user.avatar.startsWith("a_") ? "gif" : "png";
      return `https://cdn.discordapp.com/avatars/${encodeURIComponent(user.id)}/${encodeURIComponent(user.avatar)}.${extension}?size=128`;
    }

    let index = 0;
    if (user.discriminator && user.discriminator !== "0") {
      index = Number(user.discriminator) % 5;
    } else if (user.id) {
      try {
        index = Number((BigInt(user.id) >> 22n) % 6n);
      } catch {
        index = 0;
      }
    }
    return `https://cdn.discordapp.com/embed/avatars/${index}.png`;
  }

  function activityImage(activity: Activity): string | null {
    const image = activity.assets?.large_image;
    if (!image) return null;

    if (image.startsWith("mp:external/")) {
      return safeUrl(`https://media.discordapp.net/${image.slice(3)}`);
    }
    if (image.startsWith("spotify:")) {
      return safeUrl(`https://i.scdn.co/image/${image.slice(8)}`);
    }
    if (activity.application_id) {
      return safeUrl(
        `https://cdn.discordapp.com/app-assets/${encodeURIComponent(activity.application_id)}/${encodeURIComponent(image)}.png`,
      );
    }
    return null;
  }

  function emojiHtml(emoji: ActivityEmoji): string {
    if (emoji.id) {
      const extension = emoji.animated ? "gif" : "png";
      const url = safeUrl(
        `https://cdn.discordapp.com/emojis/${encodeURIComponent(emoji.id)}.${extension}?size=32`,
      );
      if (url) {
        return `<img src="${esc(url)}" alt="${esc(emoji.name ?? "emoji")}" width="16" height="16" loading="lazy" class="w-4 h-4 shrink-0" />`;
      }
    }
    return emoji.name ? `<span class="shrink-0">${esc(emoji.name)}</span>` : "";
  }

  function platformLabel(presence: Presence): string {
    const platforms: string[] = [];
    if (presence.active_on_discord_desktop) platforms.push("Desktop");
    if (presence.active_on_discord_mobile) platforms.push("Mobile");
    if (presence.active_on_discord_web) platforms.push("Web");
    return platforms.join(" · ");
  }

  function renderActivity(activity: Activity): string {
    const label = TYPE_LABEL[activity.type] ?? "Activity";
    const image = activityImage(activity);
    const start = toMs(activity.timestamps?.start);
    const elapsed = start
      ? `<p class="mt-0.5 text-xs tabular-nums text-gray-400" data-discord-elapsed data-start="${start}">${formatTime(Date.now() - start)} elapsed</p>`
      : "";
    const details = activity.details
      ? `<p class="truncate text-xs text-gray-600 dark:text-gray-400">${esc(activity.details)}</p>`
      : "";
    const state = activity.state
      ? `<p class="truncate text-xs text-gray-500">${esc(activity.state)}</p>`
      : "";
    const media = image
      ? `<img src="${esc(image)}" alt="" width="56" height="56" loading="lazy" class="h-14 w-14 shrink-0 rounded-lg bg-gray-100 object-cover dark:bg-gray-800" />`
      : `<div class="flex h-14 w-14 shrink-0 items-center justify-center rounded-lg bg-gray-100 text-gray-400 dark:bg-gray-800"><svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 5v2m0 4v2m0 4v2M5 5h6a3 3 0 0 1 3 3v10a3 3 0 0 1-3 3H5a3 3 0 0 1-3-3V8a3 3 0 0 1 3-3z" /></svg></div>`;

    return `
      <div class="flex items-center gap-3">
        ${media}
        <div class="min-w-0 flex-1">
          <p class="text-[10px] font-semibold uppercase tracking-wider text-gray-400">${label}</p>
          <p class="truncate text-sm font-medium dark:text-gray-100">${esc(activity.name ?? "Unknown activity")}</p>
          ${details}
          ${state}
          ${elapsed}
        </div>
      </div>`;
  }

  function renderSpotify(spotify: Spotify): string {
    const start = toMs(spotify.timestamps?.start);
    const end = toMs(spotify.timestamps?.end);
    const now = Date.now();
    const percent =
      start && end && end > start
        ? Math.min(100, Math.max(0, ((now - start) / (end - start)) * 100))
        : 0;
    const artists = Array.isArray(spotify.artists) ? spotify.artists.join(", ") : "";
    const trackUrl = spotify.track_id
      ? safeUrl(`https://open.spotify.com/track/${encodeURIComponent(spotify.track_id)}`)
      : null;
    const title = trackUrl
      ? `<a href="${esc(trackUrl)}" target="_blank" rel="noopener noreferrer" class="block truncate text-sm font-medium hover:underline dark:text-gray-100">${esc(spotify.song ?? "Unknown track")}</a>`
      : `<p class="truncate text-sm font-medium dark:text-gray-100">${esc(spotify.song ?? "Unknown track")}</p>`;
    const art = spotify.album_art_url
      ? `<img src="${esc(spotify.album_art_url)}" alt="" width="56" height="56" loading="lazy" class="h-14 w-14 shrink-0 rounded-lg bg-gray-100 object-cover dark:bg-gray-800" />`
      : `<div class="h-14 w-14 shrink-0 rounded-lg bg-gray-100 dark:bg-gray-800"></div>`;

    return `
      <div class="flex items-center gap-3" data-discord-spotify>
        ${art}
        <div class="min-w-0 flex-1">
          <p class="flex items-center gap-1 text-[10px] font-semibold uppercase tracking-wider text-emerald-600 dark:text-emerald-400">
            <svg class="h-3 w-3" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 0C5.4 0 0 5.4 0 12s5.4 12 12 12 12-5.4 12-12S18.66 0 12 0zm5.521 17.34c-.24.359-.66.48-1.021.24-2.82-1.74-6.36-2.101-10.561-1.141-.418.122-.779-.179-.899-.539-.12-.421.18-.78.54-.9 4.56-1.021 8.52-.6 11.64 1.32.42.18.479.659.301 1.02zm1.44-3.3c-.301.42-.841.6-1.262.3-3.239-1.98-8.159-2.58-11.939-1.38-.479.12-1.02-.12-1.14-.6-.12-.48.12-1.021.6-1.141C9.6 9.9 15 10.561 18.72 12.84c.361.181.54.78.241 1.2zm.12-3.36C15.24 8.4 8.82 8.16 5.16 9.301c-.6.179-1.2-.181-1.38-.721-.18-.601.18-1.2.72-1.381 4.26-1.26 11.28-1.02 15.721 1.621.539.3.719 1.02.42 1.56-.299.421-1.02.599-1.559.3z" /></svg>
            Listening to Spotify
          </p>
          ${title}
          <p class="truncate text-xs text-gray-500">by ${esc(artists)}</p>
          <div class="mt-2 h-1 overflow-hidden rounded-full bg-gray-200 dark:bg-gray-800">
            <div class="h-full rounded-full bg-emerald-500" style="width:${percent.toFixed(2)}%" data-discord-progress data-start="${start ?? ""}" data-end="${end ?? ""}"></div>
          </div>
          <div class="mt-1 flex justify-between text-[10px] tabular-nums text-gray-400">
            <span data-discord-position>${start ? formatTime(now - start) : "0:00"}</span>
            <span data-discord-duration>${start && end ? formatTime(end - start) : "0:00"}</span>
          </div>
        </div>
      </div>`;
  }

  function render(node: HTMLElement, presence: Presence) {
    const card = node.querySelector<HTMLElement>("[data-discord-card]");
    if (!card) return;

    const user = presence.discord_user ?? { id: node.dataset.userId ?? "" };
    const status = STATUS[presence.discord_status ?? "offline"] ?? STATUS.offline;
    const name = user.global_name || user.display_name || user.username || "Discord user";
    const platform = platformLabel(presence);
    const activities = Array.isArray(presence.activities) ? presence.activities : [];
    const custom = activities.find((activity) => activity.type === 4);
    const spotify = presence.listening_to_spotify && presence.spotify ? presence.spotify : null;
    const otherActivities = activities.filter((activity) => {
      if (activity.type === 4) return false;
      if (spotify && activity.type === 2) return false;
      return true;
    });

    const customHtml =
      custom && custom.state
        ? `<div class="flex items-center gap-2 text-sm text-gray-600 dark:text-gray-400">${custom.emoji ? emojiHtml(custom.emoji) : ""}<span class="truncate">${esc(custom.state)}</span></div>`
        : "";
    const spotifyHtml = spotify ? renderSpotify(spotify) : "";
    const activitiesHtml = otherActivities.map(renderActivity).join("");
    const hasDetails = Boolean(customHtml || spotifyHtml || activitiesHtml);
    const body = hasDetails
      ? `<div class="mt-4 space-y-4 border-t border-gray-100 pt-4 dark:border-gray-800/60">${customHtml}${spotifyHtml}${activitiesHtml}</div>`
      : `<p class="mt-4 border-t border-gray-100 pt-4 text-sm text-gray-500 dark:border-gray-800/60">${
          presence.discord_status === "offline" ? "Currently offline." : "No current activity."
        }</p>`;
    const profileUrl = user.id
      ? `https://discord.com/users/${encodeURIComponent(user.id)}`
      : "https://discord.com";

    card.innerHTML = `
      <div class="flex items-center gap-3">
        <div class="relative shrink-0">
          <img src="${esc(avatarUrl(user))}" alt="${esc(name)}" width="48" height="48" loading="lazy" class="h-12 w-12 rounded-full bg-gray-100 object-cover dark:bg-gray-800" />
          <span class="absolute -bottom-0.5 -right-0.5 h-3.5 w-3.5 rounded-full border-2 border-white dark:border-[#151515] ${status.dot}" aria-hidden="true"></span>
        </div>
        <div class="min-w-0 flex-1">
          <p class="truncate font-medium dark:text-gray-100">${esc(name)}</p>
          <p class="truncate text-xs text-gray-500">
            <span class="${status.text}">${status.label}</span>${
              platform
                ? `<span class="mx-1 text-gray-300 dark:text-gray-700">·</span>${esc(platform)}`
                : ""
            }
          </p>
        </div>
        <a href="${esc(profileUrl)}" target="_blank" rel="noopener noreferrer" aria-label="Open ${esc(name)} on Discord" class="shrink-0 rounded-full p-2 text-gray-400 transition-colors hover:bg-gray-100 hover:text-gray-700 dark:hover:bg-gray-800 dark:hover:text-gray-200">
          <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" /></svg>
        </a>
      </div>
      ${body}`;

    updateTimers();
  }

  function renderError(userId: string) {
    const profileUrl = `https://discord.com/users/${encodeURIComponent(userId)}`;
    document.querySelectorAll<HTMLElement>("[data-discord-presence]").forEach((node) => {
      if (node.dataset.userId !== userId) return;
      const card = node.querySelector<HTMLElement>("[data-discord-card]");
      if (!card) return;
      card.innerHTML = `<p class="text-sm text-gray-500">Could not load Discord presence. <a href="${esc(profileUrl)}" target="_blank" rel="noopener noreferrer" class="underline underline-offset-2 hover:text-black dark:hover:text-white">Open profile</a>.</p>`;
    });
  }

  function updateTimers() {
    const now = Date.now();

    document.querySelectorAll<HTMLElement>("[data-discord-elapsed]").forEach((element) => {
      const start = Number(element.dataset.start);
      if (Number.isFinite(start) && start > 0) {
        element.textContent = `${formatTime(now - start)} elapsed`;
      }
    });

    document.querySelectorAll<HTMLElement>("[data-discord-progress]").forEach((element) => {
      const start = Number(element.dataset.start);
      const end = Number(element.dataset.end);
      if (!Number.isFinite(start) || !Number.isFinite(end) || end <= start) return;

      const percent = Math.min(100, Math.max(0, ((now - start) / (end - start)) * 100));
      element.style.width = `${percent.toFixed(2)}%`;

      const wrapper = element.closest("[data-discord-spotify]");
      if (!wrapper) return;
      const position = wrapper.querySelector<HTMLElement>("[data-discord-position]");
      const duration = wrapper.querySelector<HTMLElement>("[data-discord-duration]");
      if (position) position.textContent = formatTime(Math.min(now, end) - start);
      if (duration) duration.textContent = formatTime(end - start);
    });
  }

  function startTicker() {
    const tickerWindow = window as Window & { __discordPresenceTicker?: number };
    if (tickerWindow.__discordPresenceTicker) return;
    tickerWindow.__discordPresenceTicker = window.setInterval(updateTimers, 1000);
  }

  function applyPresence(userId: string, connection: Connection, presence: Presence) {
    connection.presence = presence;
    document.querySelectorAll<HTMLElement>("[data-discord-presence]").forEach((node) => {
      if (node.dataset.userId === userId) render(node, presence);
    });
  }

  function handleSocketMessage(
    userId: string,
    connection: Connection,
    event: MessageEvent,
  ) {
    let message: any;
    try {
      message = JSON.parse(String(event.data));
    } catch {
      return;
    }

    if (message?.op === 1) {
      const interval = Number(message.d?.heartbeat_interval) || 30000;
      if (connection.heartbeat) window.clearInterval(connection.heartbeat);
      connection.heartbeat = window.setInterval(() => {
        if (connection.ws?.readyState === WebSocket.OPEN) {
          connection.ws.send(JSON.stringify({ op: 3 }));
        }
      }, interval);
      if (connection.ws?.readyState === WebSocket.OPEN) {
        connection.ws.send(
          JSON.stringify({ op: 2, d: { subscribe_to_id: userId } }),
        );
      }
      return;
    }

    if (message?.op !== 0) return;
    if (message.t !== "INIT_STATE" && message.t !== "PRESENCE_UPDATE") return;

    const data = message.d;
    const presence: Presence | undefined = data?.discord_user ? data : data?.[userId];
    if (presence) applyPresence(userId, connection, presence);
  }

  function openSocket(userId: string, connection: Connection) {
    if (connection.reconnect) {
      window.clearTimeout(connection.reconnect);
      connection.reconnect = undefined;
    }

    let socket: WebSocket;
    try {
      socket = new WebSocket("wss://api.lanyard.rest/socket");
    } catch {
      connection.reconnect = window.setTimeout(
        () => openSocket(userId, connection),
        connection.delay,
      );
      connection.delay = Math.min(connection.delay * 2, 30000);
      return;
    }

    connection.ws = socket;

    socket.addEventListener("open", () => {
      connection.delay = 1000;
    });

    socket.addEventListener("message", (event) => {
      handleSocketMessage(userId, connection, event);
    });

    socket.addEventListener("close", () => {
      if (connection.heartbeat) {
        window.clearInterval(connection.heartbeat);
        connection.heartbeat = undefined;
      }
      connection.ws = null;
      connection.reconnect = window.setTimeout(
        () => openSocket(userId, connection),
        connection.delay,
      );
      connection.delay = Math.min(connection.delay * 2, 30000);
    });

    socket.addEventListener("error", () => {
      try {
        socket.close();
      } catch {}
    });
  }

  function getConnection(userId: string): Connection {
    let connection = connections.get(userId);
    if (!connection) {
      connection = { ws: null, delay: 1000 };
      connections.set(userId, connection);
    }

    if (
      !connection.ws ||
      (connection.ws.readyState !== WebSocket.OPEN &&
        connection.ws.readyState !== WebSocket.CONNECTING)
    ) {
      openSocket(userId, connection);
    }

    return connection;
  }

  async function ensurePresence(userId: string) {
    const connection = getConnection(userId);
    if (connection.presence || connection.fetching) return;

    connection.fetching = true;
    try {
      const response = await fetch(
        `https://api.lanyard.rest/v1/users/${encodeURIComponent(userId)}`,
        { headers: { Accept: "application/json" } },
      );
      if (!response.ok) throw new Error(`HTTP ${response.status}`);

      const payload = await response.json();
      if (payload?.success && payload.data) {
        if (!connection.presence) {
          applyPresence(userId, connection, payload.data);
        }
      } else {
        throw new Error("Invalid Lanyard response");
      }
    } catch {
      if (!connection.presence) renderError(userId);
    } finally {
      connection.fetching = false;
    }
  }

  function init() {
    const nodes = document.querySelectorAll<HTMLElement>("[data-discord-presence]");
    if (nodes.length === 0) return;

    const userIds = new Set<string>();
    nodes.forEach((node) => {
      const userId = node.dataset.userId;
      if (!userId) return;
      userIds.add(userId);
      const connection = connections.get(userId);
      if (connection?.presence) render(node, connection.presence);
    });

    userIds.forEach((userId) => {
      void ensurePresence(userId);
    });

    startTicker();
    updateTimers();
  }

  const bootWindow = window as Window & { __discordPresenceBooted?: boolean };
  if (!bootWindow.__discordPresenceBooted) {
    bootWindow.__discordPresenceBooted = true;
    document.addEventListener("astro:page-load", init);
    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", init, { once: true });
    } else {
      init();
    }
  }
</script>
