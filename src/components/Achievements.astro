---
import data from '../models/data_achievements';
import imageDimensions from '../models/image-dimensions';
import ViewToggle from './ViewToggle.astro';

function sizeFor(src: string | null | undefined) {
  if (!src) return {};
  const size = imageDimensions[src];
  return size ? { width: size[0], height: size[1] } : {};
}
---

<section class="animate-fade-in">
  <div class="flex items-center justify-between gap-4 mb-6">
    <h1 class="text-2xl font-semibold flex items-center dark:text-gray-100">
      <svg class="w-5 h-5 mr-2 text-gray-500 dark:text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z"></path></svg>
      Achievements &amp; Certifications
    </h1>
    <ViewToggle />
  </div>
  <div class="view-items">
    {data.map((item) => (
      <div class="view-card flex flex-col reveal-on-scroll">
        {item.foto && item.foto.length > 0 && (
          <div class="view-media" style="--view-ratio: 4 / 3;" data-fit="contain">
            {item.foto.map((img, index) => (
              <a
                href={img}
                class={`gallery-trigger group h-full w-full ${index !== 0 ? 'hidden' : ''}`}
                data-title={item.judul}
              >
                {index === 0 && (
                  <img
                    src={img}
                    alt={item.judul}
                    {...sizeFor(img)}
                    class="w-full max-h-64 object-cover border border-gray-200 dark:border-gray-800 rounded-xl opacity-95 dark:opacity-85 group-hover:opacity-100 transition-all duration-500 ease-[cubic-bezier(0.16,1,0.3,1)] group-hover:scale-[1.02] cursor-zoom-in"
                    loading="lazy"
                    decoding="async"
                  />
                )}
              </a>
            ))}
          </div>
        )}

        <div class="view-body flex flex-1 flex-col">
          <h2 class="view-title text-lg font-medium text-gray-900 dark:text-gray-100 mb-1">{item.judul}</h2>
          <p class="text-xs font-medium uppercase tracking-wider text-gray-500 dark:text-gray-400 mb-3">
            {item.penerbit}
            <span class="mx-1 text-gray-300 dark:text-gray-700">&bull;</span>
            <span class="normal-case tracking-normal text-gray-500 dark:text-gray-500">{item.tanggal}</span>
          </p>

          {item.keahlian && item.keahlian.length > 0 && (
            <div class="mt-auto flex flex-wrap gap-2 text-sm text-gray-500">
              {item.keahlian.map((skill) => (
                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-gray-100 dark:bg-gray-800 text-gray-700 dark:text-gray-300 border border-gray-200 dark:border-gray-700">
                  {skill}
                </span>
              ))}
            </div>
          )}
        </div>
      </div>
    ))}
  </div>
</section>
