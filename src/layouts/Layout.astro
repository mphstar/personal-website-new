---
import "../styles/global.css";
import { ClientRouter } from "astro:transitions";
import PageTransitionCurtain from "../components/PageTransitionCurtain.astro";
import data_contact from "../models/data_contact";

type StructuredData = Record<string, unknown>;

interface Props {
	title: string;
	description?: string;
	image?: string;
	imageAlt?: string;
	type?: "website" | "article";
	lang?: "en" | "id";
	noindex?: boolean;
	publishedTime?: string;
	modifiedTime?: string;
	structuredData?: StructuredData[];
}

const {
	title,
	description = "Bintang Malindo Eka Putra (Mphstar) - Software Developer based in Indonesia specializing in web and mobile applications.",
	image = "/og-image.png",
	imageAlt = "Mphstar - Software Developer",
	type = "website",
	lang = "en",
	noindex = false,
	publishedTime,
	modifiedTime,
	structuredData = [],
} = Astro.props;

const siteURL = Astro.site || new URL("https://mphstar.my.id");
const canonicalURL = new URL(Astro.url.pathname, siteURL);
const ogImageURL = new URL(image, siteURL);
const siteRoot = new URL("/", siteURL).toString();

const personId = `${siteRoot}#person`;
const websiteId = `${siteRoot}#website`;

const socialProfiles = data_contact
	.filter((contact) => contact.link.startsWith("http"))
	.map((contact) => contact.link);

const ogLocale = lang === "id" ? "id_ID" : "en_US";

const jsonLd = {
	"@context": "https://schema.org",
	"@graph": [
		{
			"@type": "Person",
			"@id": personId,
			name: "Bintang Malindo Eka Putra",
			alternateName: "Mphstar",
			url: siteRoot,
			image: new URL("/assets/pp-384.webp", siteURL).toString(),
			jobTitle: "Software Developer",
			description:
				"Informatics Engineering graduate building web and mobile products end to end, based in Indonesia.",
			knowsAbout: [
				"Web Development",
				"Mobile Development",
				"Frontend Engineering",
				"Backend Development",
				"JavaScript",
				"TypeScript",
				"PHP",
				"Laravel",
				"React",
				"Next.js",
				"Flutter",
			],
			alumniOf: {
				"@type": "CollegeOrUniversity",
				name: "Jember State Polytechnic",
			},
			sameAs: socialProfiles,
		},
		{
			"@type": "WebSite",
			"@id": websiteId,
			url: siteRoot,
			name: "Mphstar",
			description:
				"Personal site of Bintang Malindo Eka Putra (Mphstar): portfolio, achievements, and notes.",
			inLanguage: lang,
			publisher: { "@id": personId },
		},
		...structuredData,
	],
};

const jsonLdString = JSON.stringify(jsonLd).replace(/</g, "\\u003c");
---

<!doctype html>
<html lang={lang}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<meta
			name="robots"
			content={
				noindex
					? "noindex, follow"
					: "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"
			}
		/>
		<meta name="author" content="Bintang Malindo Eka Putra" />
		<meta name="theme-color" content="#fcfcfc" media="(prefers-color-scheme: light)" />
		<meta name="theme-color" content="#111111" media="(prefers-color-scheme: dark)" />

		<!-- Favicons -->
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
		<link rel="icon" href="/favicon.ico" sizes="48x48" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />

		<link rel="canonical" href={canonicalURL} />

		<!-- Fonts: preconnect first so the stylesheet request starts earlier -->
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&display=swap"
			rel="stylesheet"
		/>

		<!-- OpenGraph Tags -->
		<meta property="og:type" content={type} />
		<meta property="og:site_name" content="Mphstar" />
		<meta property="og:locale" content={ogLocale} />
		<meta property="og:url" content={canonicalURL} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={ogImageURL} />
		<meta property="og:image:type" content="image/png" />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content={imageAlt} />
		{publishedTime && <meta property="article:published_time" content={publishedTime} />}
		{modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
		{publishedTime && <meta property="article:author" content="Bintang Malindo Eka Putra" />}

		<!-- Twitter Tags -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:url" content={canonicalURL} />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImageURL} />
		<meta name="twitter:image:alt" content={imageAlt} />

		<script type="application/ld+json" set:html={jsonLdString} />

		<ClientRouter />
	</head>
	<body
		class="bg-[#fcfcfc] dark:bg-[#111] text-[#111] dark:text-gray-200 font-sans antialiased leading-relaxed max-w-2xl mx-auto px-6 transition-colors duration-300 relative"
	>
		<PageTransitionCurtain />
		<script is:inline>
			function applyTheme() {
				const theme = (() => {
					if (
						typeof localStorage !== "undefined" &&
						localStorage.getItem("theme")
					) {
						return localStorage.getItem("theme");
					}
					if (window.matchMedia("(prefers-color-scheme: dark)").matches) {
						return "dark";
					}
					return "light";
				})();

				if (theme === "light") {
					document.documentElement.classList.remove("dark");
				} else {
					document.documentElement.classList.add("dark");
				}
				window.localStorage.setItem("theme", theme);
			}

			applyTheme();

			document.addEventListener("astro:after-swap", applyTheme);

			function applyViewLayout() {
				let view = "list";
				try {
					if (window.localStorage.getItem("view-layout") === "grid") {
						view = "grid";
					}
				} catch {}
				document.documentElement.dataset.view = view;
			}

			applyViewLayout();

			document.addEventListener("astro:after-swap", applyViewLayout);
		</script>

		<header
			class="flex justify-between items-start sticky top-0 bg-[#fcfcfc] dark:bg-[#111] z-40 pt-8 mb-12 border-b border-gray-200 dark:border-gray-800 pb-6 transition-colors duration-300"
		>
			<div>
				<div class="text-xl font-semibold mb-4">
					<a href="/" class="hover:underline">Mphstar.</a>
				</div>
				<nav
					class="flex gap-4 text-sm font-medium text-gray-600 dark:text-gray-400"
				>
					<a
						href="/"
						class="motion-nav-link hover:text-black dark:hover:text-white transition-colors"
						>Home</a
					>
					<a
						href="/portfolio"
						class="motion-nav-link hover:text-black dark:hover:text-white transition-colors"
						>Portfolio</a
					>
					<a
						href="/achievements"
						class="motion-nav-link hover:text-black dark:hover:text-white transition-colors"
						>Achievements</a
					>
					<a
						href="/notes"
						class="motion-nav-link hover:text-black dark:hover:text-white transition-colors"
						>Notes</a
					>
				</nav>
			</div>

			<button
				id="themeToggle"
				class="p-2 rounded-full hover:bg-gray-100 dark:hover:bg-gray-800 transition-all duration-200 active:scale-90"
				aria-label="Toggle theme"
			>
				<svg
					id="sun-icon"
					class="w-5 h-5 hidden dark:block transition-transform duration-300 hover:rotate-45"
					fill="none"
					stroke="currentColor"
					viewBox="0 0 24 24"
					><path
						stroke-linecap="round"
						stroke-linejoin="round"
						stroke-width="2"
						d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"
					></path></svg
				>
				<svg
					id="moon-icon"
					class="w-5 h-5 block dark:hidden transition-transform duration-300 hover:-rotate-12"
					fill="none"
					stroke="currentColor"
					viewBox="0 0 24 24"
					><path
						stroke-linecap="round"
						stroke-linejoin="round"
						stroke-width="2"
						d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"
					></path></svg
				>
			</button>
		</header>

		<script>
			// @ts-nocheck
			let themeTransitionRunning = false;

			function commitTheme(isDark) {
				document.documentElement.classList.toggle("dark", isDark);
				try {
					localStorage.setItem("theme", isDark ? "dark" : "light");
				} catch {}
			}

			function initThemeToggle() {
				const toggleBtn = document.getElementById("themeToggle");
				if (!toggleBtn || toggleBtn.dataset.bound === "true") return;
				toggleBtn.dataset.bound = "true";

				toggleBtn.addEventListener("click", () => {
					const isDark =
						!document.documentElement.classList.contains("dark");
					const reduceMotion = window.matchMedia(
						"(prefers-reduced-motion: reduce)",
					).matches;

					if (
						themeTransitionRunning ||
						reduceMotion ||
						typeof document.startViewTransition !== "function"
					) {
						commitTheme(isDark);
						return;
					}

					const root = document.documentElement;
					themeTransitionRunning = true;
					root.classList.add("theme-anim");

					const cleanup = () => {
						root.classList.remove("theme-anim");
						themeTransitionRunning = false;
					};

					let transition;
					try {
						transition = document.startViewTransition(() =>
							commitTheme(isDark),
						);
					} catch {
						cleanup();
						commitTheme(isDark);
						return;
					}

					transition.ready
						.then(() => {
							const centerX = window.innerWidth / 2;
							const centerY = window.innerHeight / 2;
							const radius = Math.hypot(
								Math.max(centerX, window.innerWidth - centerX),
								Math.max(centerY, window.innerHeight - centerY),
							);

							root.animate(
								{
									clipPath: [
										`circle(0px at ${centerX}px ${centerY}px)`,
										`circle(${radius}px at ${centerX}px ${centerY}px)`,
									],
								},
								{
									duration: 720,
									easing: "cubic-bezier(0.22, 1, 0.36, 1)",
									pseudoElement:
										"::view-transition-new(root)",
								},
							);
						})
						.catch(() => {});

					transition.finished.then(cleanup, cleanup);
				});
			}

			// Minimal Gallery Logic
			function initMinimalGallery() {
				const triggers = document.querySelectorAll(".gallery-trigger");
				const lightbox = document.getElementById("minimal-lightbox");
				const lightboxImg = document.getElementById(
					"minimal-lightbox-img",
				);
				const closeBtn = document.getElementById(
					"minimal-lightbox-close",
				);
				const prevBtn = document.getElementById(
					"minimal-lightbox-prev",
				);
				const nextBtn = document.getElementById(
					"minimal-lightbox-next",
				);

				if (!lightbox || triggers.length === 0) return;

				let galleryItems = [];
				let currentIndex = 0;

				function openLightbox(index) {
					currentIndex = index;
					updateImage();
					lightbox.classList.remove(
						"opacity-0",
						"pointer-events-none",
					);
					if (lightboxImg) {
						lightboxImg.classList.remove("scale-95");
						lightboxImg.classList.add("scale-100");
					}
				}

				function closeLightbox() {
					lightbox.classList.add("opacity-0", "pointer-events-none");
					if (lightboxImg) {
						lightboxImg.classList.remove("scale-100");
						lightboxImg.classList.add("scale-95");
					}
				}

				function updateImage() {
					if (galleryItems.length > 0) {
						lightboxImg.style.opacity = "0";
						setTimeout(() => {
							lightboxImg.src = galleryItems[currentIndex];
							lightboxImg.style.opacity = "1";
						}, 150);
					}
				}

				function nextImage(e) {
					if (e) e.stopPropagation();
					if (galleryItems.length > 1) {
						currentIndex = (currentIndex + 1) % galleryItems.length;
						updateImage();
					}
				}

				function prevImage(e) {
					if (e) e.stopPropagation();
					if (galleryItems.length > 1) {
						currentIndex =
							(currentIndex - 1 + galleryItems.length) %
							galleryItems.length;
						updateImage();
					}
				}

				// Reset state
				galleryItems = Array.from(triggers).map(
					(t) => t.getAttribute("href") || t.getAttribute("data-img"),
				);

				// Bind clicks (we don't cloneNode because astro:page-load handles clean scopes)
				triggers.forEach((trigger, idx) => {
					trigger.addEventListener("click", (e) => {
						e.preventDefault();
						openLightbox(idx);
					});
				});

				// Bind close logic
				lightbox.addEventListener("click", closeLightbox);
				if (closeBtn) closeBtn.addEventListener("click", closeLightbox);
				if (lightboxImg)
					lightboxImg.addEventListener("click", (e) =>
						e.stopPropagation(),
					);
				if (nextBtn) nextBtn.addEventListener("click", nextImage);
				if (prevBtn) prevBtn.addEventListener("click", prevImage);
			}

			// Scroll Reveal Engine
			function initScrollReveal() {
				const elements = document.querySelectorAll(".reveal-on-scroll:not(.is-revealed)");
				if (elements.length === 0) return;

				const observer = new IntersectionObserver(
					(entries) => {
						entries.forEach((entry) => {
							if (entry.isIntersecting) {
								entry.target.classList.add("is-revealed");
								observer.unobserve(entry.target);
							}
						});
					},
					{ threshold: 0.08, rootMargin: "0px 0px -40px 0px" }
				);

				elements.forEach((el) => observer.observe(el));
			}

			// Lenis Inertia Smooth Scroll
			let lenisInstance = null;
			async function initSmoothScroll() {
				if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
					return;
				}
				if (!lenisInstance) {
					try {
						const { default: Lenis } = await import("lenis");
						lenisInstance = new Lenis({
							duration: 1.05,
							easing: (t) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
							touchMultiplier: 1.5,
						});

						function raf(time) {
							lenisInstance?.raf(time);
							requestAnimationFrame(raf);
						}
						requestAnimationFrame(raf);
					} catch {}
				}
			}

			document.addEventListener("astro:after-swap", () => {
				lenisInstance?.scrollTo(0, { immediate: true });
			});

			// Back to top control
			const SCROLL_TOP_OFFSET = 480;
			let scrollTopTicking = false;

			function updateScrollTop() {
				const button = document.getElementById("scrollTop");
				if (!button) return;

				const visible = window.scrollY > SCROLL_TOP_OFFSET;
				button.classList.toggle("is-visible", visible);
				button.setAttribute("aria-hidden", visible ? "false" : "true");
				button.tabIndex = visible ? 0 : -1;
			}

			function initScrollTop() {
				const button = document.getElementById("scrollTop");
				if (!button) return;

				if (!window.__scrollTopBound) {
					window.__scrollTopBound = true;
					window.addEventListener(
						"scroll",
						() => {
							if (scrollTopTicking) return;
							scrollTopTicking = true;
							requestAnimationFrame(() => {
								updateScrollTop();
								scrollTopTicking = false;
							});
						},
						{ passive: true },
					);
				}

				if (button.dataset.bound !== "true") {
					button.dataset.bound = "true";
					button.addEventListener("click", () => {
						const reduce = window.matchMedia(
							"(prefers-reduced-motion: reduce)",
						).matches;

						if (lenisInstance) {
							lenisInstance.scrollTo(
								0,
								reduce ? { immediate: true } : { duration: 1.1 },
							);
						} else {
							window.scrollTo({
								top: 0,
								behavior: reduce ? "auto" : "smooth",
							});
						}
					});
				}

				updateScrollTop();
			}

			// We use astro:page-load to run on initial load AND every client-side navigation
			document.addEventListener("astro:page-load", () => {
				if (localStorage.getItem("theme") === "dark") {
					document.documentElement.classList.add("dark");
				}
				initThemeToggle();
				initMinimalGallery();
				initScrollReveal();
				initSmoothScroll();
				initScrollTop();
			});
		</script>

		<main class="space-y-12">
			<slot />
		</main>
		<footer
			class="mt-16 pt-8 pb-12 md:pb-20 border-t border-gray-200 dark:border-gray-800 text-sm text-gray-500 transition-colors duration-300"
		>
			<p>
				&copy; {new Date().getFullYear()} Mphstar. All rights reserved.
			</p>
		</footer>

		<div
			class="pointer-events-none fixed inset-x-0 bottom-0 z-40 mx-auto flex max-w-2xl justify-end px-6 pb-6"
		>
			<button
				id="scrollTop"
				type="button"
				aria-label="Back to top"
				title="Back to top"
				aria-hidden="true"
				tabindex="-1"
				class="scroll-top inline-flex h-10 w-10 items-center justify-center rounded-full border border-gray-200 bg-white text-gray-500 shadow-sm hover:border-gray-300 hover:text-black hover:shadow-md dark:border-gray-800 dark:bg-[#151515] dark:text-gray-400 dark:hover:border-gray-600 dark:hover:text-white"
			>
				<svg
					class="h-4 w-4"
					fill="none"
					stroke="currentColor"
					viewBox="0 0 24 24"
					aria-hidden="true"
				>
					<path
						stroke-linecap="round"
						stroke-linejoin="round"
						stroke-width="2"
						d="M12 19V5M5 12l7-7 7 7"
					/>
				</svg>
			</button>
		</div>

		<!-- Minimal Lightbox Overlay -->
		<div
			id="minimal-lightbox"
			class="fixed inset-0 z-50 bg-black/70 dark:bg-black/80 flex items-center justify-center opacity-0 pointer-events-none transition-opacity duration-300 backdrop-blur-md"
		>
			<button
				id="minimal-lightbox-close"
				class="absolute top-6 right-6 p-2 text-white/70 hover:text-white transition-colors"
				aria-label="Close"
			>
				<svg
					class="w-8 h-8"
					fill="none"
					stroke="currentColor"
					viewBox="0 0 24 24"
					><path
						stroke-linecap="round"
						stroke-linejoin="round"
						stroke-width="1.5"
						d="M6 18L18 6M6 6l12 12"></path></svg
				>
			</button>

			<button
				id="minimal-lightbox-prev"
				class="absolute left-4 md:left-8 p-4 text-white/50 hover:text-white transition-colors"
				aria-label="Previous"
			>
				<svg
					class="w-8 h-8"
					fill="none"
					stroke="currentColor"
					viewBox="0 0 24 24"
					><path
						stroke-linecap="round"
						stroke-linejoin="round"
						stroke-width="1.5"
						d="M15 19l-7-7 7-7"></path></svg
				>
			</button>

			<img
				id="minimal-lightbox-img"
				src=""
				alt="Gallery Image"
				class="max-h-[85vh] max-w-[85vw] object-contain rounded-lg shadow-2xl transition-all duration-300 transform scale-95"
			/>

			<button
				id="minimal-lightbox-next"
				class="absolute right-4 md:right-8 p-4 text-white/50 hover:text-white transition-colors"
				aria-label="Next"
			>
				<svg
					class="w-8 h-8"
					fill="none"
					stroke="currentColor"
					viewBox="0 0 24 24"
					><path
						stroke-linecap="round"
						stroke-linejoin="round"
						stroke-width="1.5"
						d="M9 5l7 7-7 7"></path></svg
				>
			</button>
		</div>
	</body>
</html>
<style is:global>
	:root {
		--font-sans:
			"Inter", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto,
			Helvetica, Arial, sans-serif;
	}
	body {
		font-family: var(--font-sans);
	}
</style>
