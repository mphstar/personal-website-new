---
import Layout from "../../layouts/Layout.astro";

const site = Astro.site ?? new URL("https://mphstar.my.id");
const root = new URL("/", site).toString();
const pageUrl = new URL("/notes", site).toString();

const structuredData = [
  {
    "@type": "CollectionPage",
    "@id": `${pageUrl}#page`,
    url: pageUrl,
    name: "Notes",
    description:
      "Technical write-ups and build notes by Bintang Malindo Eka Putra (Mphstar).",
    inLanguage: "en",
    isPartOf: { "@id": `${root}#website` },
    about: { "@id": `${root}#person` },
  },
  {
    "@type": "BreadcrumbList",
    itemListElement: [
      {
        "@type": "ListItem",
        position: 1,
        name: "Home",
        item: root,
      },
      {
        "@type": "ListItem",
        position: 2,
        name: "Notes",
        item: pageUrl,
      },
    ],
  },
];
---

<Layout
  title="Notes | Bintang Malindo Eka Putra (Mphstar)"
  description="Technical notes and build write-ups by Bintang Malindo Eka Putra (Mphstar). The section is being written; new posts will appear here."
  structuredData={structuredData}
>
  <section
    class="animate-fade-in flex min-h-[62vh] flex-col items-center justify-center py-16 text-center md:py-24"
  >
    <div class="wip-art" aria-hidden="true"></div>

    <p
      class="mt-9 inline-flex items-center gap-2 text-[11px] font-semibold uppercase tracking-[0.18em] text-gray-500 dark:text-gray-400"
    >
      <span class="h-1.5 w-1.5 rounded-full bg-emerald-500" aria-hidden="true"
      ></span>
      Work in progress
    </p>

    <h1
      class="mt-3 text-2xl font-semibold tracking-tight text-gray-900 sm:text-3xl dark:text-gray-100"
    >
      Notes are still being written
    </h1>

    <p
      class="mt-3 max-w-sm text-sm leading-relaxed text-gray-600 dark:text-gray-400"
    >
      This is where longer write-ups will live: build notes, debugging stories,
      and things I had to learn the hard way. Nothing is published yet.
    </p>

    <div class="mt-8 flex items-center gap-5 text-sm font-medium">
      <a
        href="/"
        class="text-gray-900 underline-offset-4 hover:underline dark:text-gray-100"
      >
        Back home
      </a>
      <span class="text-gray-300 dark:text-gray-700" aria-hidden="true">/</span>
      <a
        href="/portfolio"
        class="text-gray-500 underline-offset-4 hover:text-black hover:underline dark:text-gray-400 dark:hover:text-white"
      >
        Browse projects
      </a>
    </div>
  </section>
</Layout>
