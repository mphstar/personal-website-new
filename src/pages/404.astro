---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="Page not found | Mphstar"
  description="This page does not exist. Head back to the home page to find the portfolio, achievements, and notes."
  noindex
>
  <section
    class="animate-fade-in flex min-h-[60vh] flex-col items-center justify-center py-16 text-center md:py-24"
  >
    <p class="font-mono text-sm tracking-widest text-gray-400 dark:text-gray-500">
      404
    </p>

    <h1
      class="mt-3 text-2xl font-semibold tracking-tight text-gray-900 sm:text-3xl dark:text-gray-100"
    >
      This page does not exist
    </h1>

    <p class="mt-3 max-w-sm text-sm leading-relaxed text-gray-600 dark:text-gray-400">
      The link may be out of date, or the page was never written. Everything
      that does exist is one click away.
    </p>

    <div class="mt-8 flex items-center gap-5 text-sm font-medium">
      <a
        href="/"
        class="text-gray-900 underline-offset-4 hover:underline dark:text-gray-100"
      >
        Back home
      </a>
      <span class="text-gray-300 dark:text-gray-700" aria-hidden="true">/</span>
      <a
        href="/portfolio"
        class="text-gray-500 underline-offset-4 hover:text-black hover:underline dark:text-gray-400 dark:hover:text-white"
      >
        Browse projects
      </a>
    </div>
  </section>
</Layout>
